# Copy to .env only for local development. Generate a private 32+ byte secret;
# never reuse this development mode or secret in production.
IDW_ENVIRONMENT=local
IDW_AUTH_MODE=development
IDW_DEVELOPMENT_AUTH_SECRET=

# Set DATABASE_URL to a PostgreSQL 16 runtime role, not a migration/owner role.
IDW_DATABASE_URL=postgresql+psycopg://channel360_test_app@127.0.0.1:5432/channel360_test
IDW_WORKER_DATABASE_URL=postgresql+psycopg://channel360_test_worker@127.0.0.1:5432/channel360_test
IDW_MIGRATION_DATABASE_URL=postgresql+psycopg://channel360_test_migrator@127.0.0.1:5432/channel360_test
IDW_STORAGE_ROOT=.runtime/document-storage
IDW_CLAMAV_SOCKET_PATH=/opt/homebrew/var/run/clamav/clamd.sock
IDW_MAX_UPLOAD_BYTES=52428800
IDW_WEB_ORIGINS=http://127.0.0.1:5174
IDW_LOG_LEVEL=INFO

# DOCX verification is resolved by the API; browser requests cannot change it.
# Standard editing/release is structural-only and does not run LibreOffice.
CHANNEL360_DOCX_VERIFICATION_MODE=structural
# Optional strict profile (fails closed if isolated rendering cannot run):
# CHANNEL360_DOCX_VERIFICATION_MODE=structural_and_visual

# Optional AI explanations. Disabled by default; configure only for synthetic
# development documents unless external processing has been privacy-approved.
# CHANNEL360_LLM_PROVIDER=openai_compatible
# CHANNEL360_LLM_API_KEY=replace-with-a-secret-stored-outside-version-control
# CHANNEL360_LLM_MODEL=your-approved-model-name
# CHANNEL360_LLM_BASE_URL=https://api.example.com/v1
# CHANNEL360_LLM_TIMEOUT_SECONDS=20
# CHANNEL360_LLM_MAX_OUTPUT_TOKENS=500
